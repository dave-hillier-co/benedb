{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@benedb/core/*": ["./packages/core/src/*"],
      "@benedb/schema/*": ["./packages/schema/src/*"],
      "@benedb/datastore/*": ["./packages/datastore/src/*"],
      "@benedb/engine/*": ["./packages/engine/src/*"],
      "@benedb/grains/*": ["./packages/grains/src/*"],
      "@benedb/protos/*": ["./packages/protos/src/*"],
      "@benedb/api/*": ["./packages/api/src/*"],
      "@benedb/silo/*": ["./packages/silo/src/*"],
      "@benedb/conformance/*": ["./packages/conformance/src/*"],
      "@thresh/core/*": ["../thresh/packages/core/src/*"],
      "@thresh/messaging/*": ["../thresh/packages/messaging/src/*"],
      "@thresh/directory/*": ["../thresh/packages/directory/src/*"],
      "@thresh/runtime/*": ["../thresh/packages/runtime/src/*"],
      "@thresh/clustering-k8s/*": ["../thresh/packages/clustering-k8s/src/*"],
      "@thresh/hosting/*": ["../thresh/packages/hosting/src/*"],
      "@thresh/persistence/*": ["../thresh/packages/persistence/src/*"],
      "@thresh/transactions/*": ["../thresh/packages/transactions/src/*"],
      "@thresh/journaling/*": ["../thresh/packages/journaling/src/*"],
      "@thresh/durable-jobs/*": ["../thresh/packages/durable-jobs/src/*"],
      "@thresh/observability/*": ["../thresh/packages/observability/src/*"],
      "@thresh/reminders/*": ["../thresh/packages/reminders/src/*"],
      "@thresh/streams/*": ["../thresh/packages/streams/src/*"],
      "@thresh/client/*": ["../thresh/packages/client/src/*"],
      "@thresh/testing/*": ["../thresh/packages/testing/src/*"],
      "@benedb/differential/*": ["./packages/differential/src/*"]
    }
  }
}
